---
import type { Experiment } from '../lib/experiments';
import { screenshotPath, url } from '../lib/experiments';

interface Props {
  experiment: Experiment;
}

const { slug, title, description, tags = [] } = Astro.props.experiment;
---

<a class="card" href={url(`experiments/${slug}/`)}>
  <div class="preview">
    <img
      src={url(screenshotPath(slug))}
      alt={`Screenshot of ${title}`}
      loading="lazy"
      width="1280"
      height="800"
      onerror="this.remove()"
    />
    <span class="placeholder" aria-hidden="true">
      {title.charAt(0)}
    </span>
  </div>
  <div class="body">
    <h2>{title}</h2>
    <p>{description}</p>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
  }

  .preview {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 35%, var(--bg)),
      var(--bg)
    );
  }

  .preview img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 64px;
    font-weight: 700;
    color: color-mix(in srgb, var(--text) 25%, transparent);
  }

  .body {
    padding: 16px;
  }

  h2 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .tags span {
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
  }
</style>
