---
import type { ExperimentMeta } from '../lib/experiments';
import { url } from '../lib/experiments';

type Props = Pick<ExperimentMeta, 'title' | 'description' | 'date' | 'tags'>;

const { title, description, date, tags = [] } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<header class="experiment-header">
  <a class="back" href={url('/')} aria-label="Back to all experiments">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        d="M15 18l-6-6 6-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <span>Experiments</span>
  </a>

  <div class="info">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>

  <div class="meta">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
    <time datetime={date}>{formattedDate}</time>
  </div>
</header>

<style>
  .experiment-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--header-height);
    padding: 0 16px;
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .back {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 4px;
    padding: 8px 12px 8px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s;
  }

  .back:hover {
    background: var(--bg);
  }

  .info {
    min-width: 0;
    flex: 1;
  }

  h1 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }

  p {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  .tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .back span,
    .meta {
      display: none;
    }
    .back {
      padding: 8px;
    }
  }
</style>
